# RPM spec for the PyInstaller build in /opt/phoenix. Filled in and run by
# scripts/build/build-linux-packages.sh; @VERSION@ and @RELEASE@ are replaced.

Name:           phoenix
Version:        @VERSION@
Release:        @RELEASE@
Summary:        Phoenix Desktop Application
License:        GPL-2.0-or-later
URL:            https://phoenix.exposed
BuildArch:      x86_64

# The bundle carries its own Python and Qt; don't scan it for library deps.
AutoReqProv:    no
Requires:       wireguard-tools
Requires:       (xcb-util-cursor or libxcb-cursor0)
# What the bundle loads from the system (Qt's GL, Wayland and font libraries).
Requires:       libGL.so.1()(64bit)
Requires:       libEGL.so.1()(64bit)
Requires:       libxcb.so.1()(64bit)
Requires:       libwayland-client.so.0()(64bit)
Requires:       libwayland-cursor.so.0()(64bit)
Requires:       libwayland-egl.so.1()(64bit)
Requires:       fontconfig
Obsoletes:      resistine < 2026
Provides:       resistine

# Ship the PyInstaller files untouched: no stripping, debuginfo or build-id links.
%global debug_package %{nil}
%global __os_install_post %{nil}
%define _build_id_links none

%description
Phoenix is a security endpoint and VPN manager.

%install
cp -a %{_phoenix_root}/. %{buildroot}/

%post
update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || :
# openSUSE: zypper reads its own repo directory. (No rpm --import here: rpm
# can't be run from its own scriptlet; dnf imports the key from gpgkey= on
# first refresh.)
if [ -d /etc/zypp/repos.d ] && [ ! -e /etc/zypp/repos.d/phoenix.repo ]; then
	cp /usr/share/phoenix/phoenix-zypp.repo /etc/zypp/repos.d/phoenix.repo || :
fi

%postun
update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || :

%files
/opt/phoenix
# The Phoenix repository (packaging/linux/repo), so dnf/zypper upgrade it.
%config(noreplace) /etc/yum.repos.d/phoenix.repo
/etc/pki/rpm-gpg/RPM-GPG-KEY-phoenix
/usr/share/phoenix/phoenix-zypp.repo
/usr/bin/phoenix
/usr/share/applications/phoenix.desktop
/usr/share/pixmaps/phoenix.png
