# Phoenix updates: installed by the phoenix package, which upgrades through
# this repository from then on (scripts/build/publish-linux-repos.sh). The
# repository metadata is signed and lists every package's checksum.
[phoenix]
name=Phoenix
baseurl=https://phoenix.exposed/linux/rpm
enabled=1
gpgcheck=0
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-phoenix
metadata_expire=6h
