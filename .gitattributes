# Force LF line endings for all text files
* text=auto eol=lf

# Ensure shell scripts are always LF (critical for shebang on macOS/Linux)
*.sh text eol=lf

# Binary files — don't touch
*.dmg binary
*.icns binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.whl binary

# Shown as-is by the Windows installer's licence page, and compared byte for
# byte with the generator's output: keep its CRLF line endings.
packaging/windows/InstallAgreement.txt -text
