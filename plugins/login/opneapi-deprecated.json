{
    "openapi": "3.1.0",
    "info": {
        "title": "FastAPI",
        "version": "0.1.0"
    },
    "paths": {
        "/send-otp": {
            "post": {
                "summary": "Send Otp",
                "operationId": "send_otp_send_otp_post",
                "requestBody": {
                    "content": {
