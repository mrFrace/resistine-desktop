+      # The current desktop release, signed again with a later expiry. Only
+      # the manifest and its signature are replaced; the packages it lists
+      # are the ones already served, checked when that release came in.
+      renew_desktop() { # <src> <dir>
+        local src="$1" dir="$2" m cur build
+        local -a files
+        m="$src/manifest.json"
+        cur="$pub/desktop/$dir/manifest.json"
+        check_desktop "$src" "$dir" renewal || return 0
+        jq -e -n --slurpfile new "$m" --slurpfile old "$cur" '
+          ($new[0] | del(.expires, .published)) == ($old[0] | del(.expires, .published))
+          and $new[0].expires > $old[0].expires
+        ' >/dev/null || { reject "$src" desktop "$dir" "renewal changes more than the expiry, or does not extend it"; return; }
+        # Dot names are never served. The signature goes first: for the
+        # instant between the two renames the app sees a manifest that does
+        # not verify and asks again later.
+        cp "$m" "$pub/desktop/$dir/.manifest.json.new"
+        cp "$m.minisig" "$pub/desktop/$dir/.manifest.json.minisig.new"
+        chmod 0644 "$pub/desktop/$dir/.manifest.json.new" "$pub/desktop/$dir/.manifest.json.minisig.new"
+        mv -T "$pub/desktop/$dir/.manifest.json.minisig.new" "$pub/desktop/$dir/manifest.json.minisig"
+        mv -T "$pub/desktop/$dir/.manifest.json.new" "$pub/desktop/$dir/manifest.json"
+        echo "RENEWED desktop $dir (expires $(jq -r .expires "$m"), build $build)"
+        rm -rf "$src" 2>/dev/null \
+          || echo "cannot clear $src: the upload must be group-writable (phoenix-pkg)" >&2
+      }
